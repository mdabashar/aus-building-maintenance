---
import type { Service } from '../data/services';
import { href } from '../lib/url';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={href(`/services/${service.slug}`)}
  class="group flex flex-col rounded-lg border border-ink-200 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-xl"
>
  <span
    class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-brand-500 text-ink-950 transition group-hover:bg-ink-950 group-hover:text-brand-500"
  >
    <svg
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={service.icon}></path>
    </svg>
  </span>
  <h3 class="font-display text-lg text-ink-950">{service.name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">
    {service.summary}
  </p>
  <span
    class="mt-4 inline-flex items-center gap-1 text-sm font-bold text-brand-600 group-hover:text-brand-700"
  >
    Learn more
    <svg
      class="h-4 w-4 transition group-hover:translate-x-1"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
      ></path>
    </svg>
  </span>
</a>
