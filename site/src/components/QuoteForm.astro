---
import { site } from '../data/site';
import { services } from '../data/services';
import { href, absoluteUrl } from '../lib/url';

interface Props {
  /** Pre-selects the service dropdown on a service page. */
  preselect?: string;
  heading?: string;
}

const { preselect, heading = 'Request a free quote' } = Astro.props;

// Posts to Web3Forms — no backend, no database, delivered straight to the
// business email. Set the access key in src/data/site.ts before launch.
const keyMissing = site.formAccessKey.startsWith('TODO');

// Web3Forms needs an absolute URL to redirect to after a successful post.
const successUrl = absoluteUrl('/thank-you', Astro.site);
---

<div class="rounded-lg border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 class="font-display text-2xl text-ink-950">{heading}</h2>
  <p class="mt-2 text-sm text-ink-600">
    Tell us what you need and we will get back to you, usually within one
    business day. Prefer to talk? Call
    <a href={site.phoneHref} class="font-semibold text-brand-600 hover:underline"
      >{site.phoneDisplay}</a
    >.
  </p>

  {
    keyMissing && (
      <p class="mt-4 rounded border-2 border-dashed border-brand-400 bg-brand-50 p-3 text-sm text-brand-900">
        <strong>Setup required:</strong> add your Web3Forms access key to
        <code class="font-mono">src/data/site.ts</code> or this form will not
        deliver.
      </p>
    )
  }

  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="mt-6 grid gap-4 sm:grid-cols-2"
  >
    <input type="hidden" name="access_key" value={site.formAccessKey} />
    <input
      type="hidden"
      name="subject"
      value="New quote request from the website"
    />
    <input type="hidden" name="from_name" value={site.shortName} />
    <input type="hidden" name="redirect" value={successUrl} />
    <!-- Honeypot: bots fill it, humans never see it. -->
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      style="display:none"
      tabindex="-1"
      autocomplete="off"
    />

    <div>
      <label for="q-name" class="mb-1 block text-sm font-semibold text-ink-800"
        >Your name <span class="text-brand-600">*</span></label
      >
      <input
        id="q-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        class="w-full rounded border border-ink-300 px-3 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
      />
    </div>

    <div>
      <label for="q-phone" class="mb-1 block text-sm font-semibold text-ink-800"
        >Phone <span class="text-brand-600">*</span></label
      >
      <input
        id="q-phone"
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        inputmode="tel"
        class="w-full rounded border border-ink-300 px-3 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
      />
    </div>

    <div>
      <label for="q-email" class="mb-1 block text-sm font-semibold text-ink-800"
        >Email</label
      >
      <input
        id="q-email"
        name="email"
        type="email"
        autocomplete="email"
        class="w-full rounded border border-ink-300 px-3 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
      />
    </div>

    <div>
      <label for="q-suburb" class="mb-1 block text-sm font-semibold text-ink-800"
        >Suburb</label
      >
      <input
        id="q-suburb"
        name="suburb"
        type="text"
        autocomplete="address-level2"
        class="w-full rounded border border-ink-300 px-3 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
      />
    </div>

    <div class="sm:col-span-2">
      <label
        for="q-service"
        class="mb-1 block text-sm font-semibold text-ink-800">What do you need?</label
      >
      <select
        id="q-service"
        name="service"
        class="w-full rounded border border-ink-300 bg-white px-3 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
      >
        <option value="">Please choose…</option>
        {
          services.map((s) => (
            <option value={s.name} selected={preselect === s.name}>
              {s.name}
            </option>
          ))
        }
        <option value="Other / not sure">Other or not sure</option>
      </select>
    </div>

    <div class="sm:col-span-2">
      <label
        for="q-message"
        class="mb-1 block text-sm font-semibold text-ink-800"
        >Tell us about the job <span class="text-brand-600">*</span></label
      >
      <textarea
        id="q-message"
        name="message"
        rows="5"
        required
        placeholder="Rough size, what you have in mind, and when you would like it done."
        class="w-full rounded border border-ink-300 px-3 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
      ></textarea>
    </div>

    <div class="sm:col-span-2">
      <button
        type="submit"
        class="w-full rounded bg-brand-500 px-6 py-3.5 font-bold text-ink-950 transition hover:bg-brand-400 sm:w-auto"
      >
        Send my request
      </button>
      <p class="mt-3 text-xs text-ink-500">
        We use your details only to respond to this enquiry. See our
        <a href={href('/privacy')} class="underline hover:text-brand-600"
          >privacy policy</a
        >.
      </p>
    </div>
  </form>
</div>
