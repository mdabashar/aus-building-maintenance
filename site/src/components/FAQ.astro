---
interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
}

const { faqs, heading = 'Common questions' } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:py-20">
  <h2 class="font-display mb-8 text-3xl text-ink-950">{heading}</h2>
  <div class="divide-y divide-ink-200 border-y border-ink-200">
    {
      faqs.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-950 [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg
              class="h-5 w-5 flex-shrink-0 text-brand-600 transition group-open:rotate-45"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </summary>
          <p class="mt-3 leading-relaxed text-ink-600">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
