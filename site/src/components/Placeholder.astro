---
interface Props {
  label: string;
  /** Aspect ratio helper class, e.g. 'aspect-[4/3]'. */
  ratio?: string;
  class?: string;
}

const { label, ratio = 'aspect-[4/3]', class: className = '' } = Astro.props;

/**
 * Deliberately obvious placeholder. Real project photography is the single
 * biggest driver of trust on a trade website, so these are designed to look
 * unfinished rather than to pass as content — nobody should be able to launch
 * the site without noticing them. Swap each one for a real photo; see the
 * README content checklist.
 */
---

<div
  class:list={[
    'relative flex items-center justify-center overflow-hidden rounded-lg border-2 border-dashed border-brand-300 bg-brand-50',
    ratio,
    className,
  ]}
>
  <div
    class="absolute inset-0 opacity-[0.18]"
    style="background-image: repeating-linear-gradient(45deg, #f5921e 0 12px, transparent 12px 24px);"
  >
  </div>
  <div class="relative px-4 text-center">
    <svg
      class="mx-auto mb-2 h-8 w-8 text-brand-600"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M18 8.25h.008v.008H18V8.25Zm.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
      ></path>
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M3 19.5h18a1.5 1.5 0 0 0 1.5-1.5V6A1.5 1.5 0 0 0 21 4.5H3A1.5 1.5 0 0 0 1.5 6v12A1.5 1.5 0 0 0 3 19.5Z"></path>
    </svg>
    <p class="text-xs font-bold tracking-wide text-brand-800 uppercase">
      Photo needed
    </p>
    <p class="mt-1 text-sm text-ink-700">{label}</p>
  </div>
</div>
