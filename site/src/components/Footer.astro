---
import { site, nav } from '../data/site';
import { services } from '../data/services';
import { href } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-ink-200">
  <div class="mx-auto max-w-7xl px-4 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <img
          src={href('/images/logo.jpg')}
          alt={`${site.name} logo`}
          width="72"
          height="72"
          class="mb-4 h-18 w-18 rounded-full object-cover"
        />
        <p class="font-display text-lg text-white">{site.shortName}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          Licensed building, renovation and property maintenance across Logan and
          the Brisbane southside.
        </p>
        <dl class="mt-4 space-y-1 text-sm">
          <div class="flex gap-2">
            <dt class="text-ink-400">Licence No.</dt>
            <dd class="text-white">{site.licenceNumber}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="text-ink-400">Company No.</dt>
            <dd class="text-white">{site.companyNumber}</dd>
          </div>
        </dl>
      </div>

      <div>
        <h2 class="font-display mb-4 text-base text-brand-400">Services</h2>
        <ul class="space-y-2 text-sm">
          {
            services.map((s) => (
              <li>
                <a
                  href={href(`/services/${s.slug}`)}
                  class="transition hover:text-brand-400"
                >
                  {s.short}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-display mb-4 text-base text-brand-400">Company</h2>
        <ul class="space-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={href(item.href)} class="transition hover:text-brand-400">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={href('/quote')} class="transition hover:text-brand-400"
              >Request a quote</a
            >
          </li>
          <li>
            <a href={href('/privacy')} class="transition hover:text-brand-400"
              >Privacy policy</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h2 class="font-display mb-4 text-base text-brand-400">Get in touch</h2>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href={site.phoneHref}
              class="font-semibold text-white transition hover:text-brand-400"
              >{site.phoneDisplay}</a
            >
          </li>
          <li>
            <a
              href={`mailto:${site.email}`}
              class="break-all transition hover:text-brand-400">{site.email}</a
            >
          </li>
          <li>
            <a
              href={site.whatsapp}
              rel="noopener"
              class="transition hover:text-brand-400">Message on WhatsApp</a
            >
          </li>
          <li class="pt-1 text-ink-300">{site.address.full}</li>
        </ul>

        <h3 class="font-display mt-6 mb-3 text-base text-brand-400">Hours</h3>
        <ul class="space-y-1 text-sm">
          {
            site.hours.map((h) => (
              <li class="flex justify-between gap-4">
                <span class="text-ink-400">{h.days}</span>
                <span class="text-white">{h.time}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 border-t border-white/10 pt-6 text-xs leading-relaxed text-ink-400"
    >
      <p>
        &copy; {year} {site.name}. All rights reserved.
        {site.abn.startsWith('TODO') ? '' : ` ABN ${site.abn}.`}
      </p>
      <p class="mt-2">
        Servicing {site.serviceAreas.slice(0, -1).join(', ')} and the surrounding
        {site.serviceAreas.at(-1)}.
      </p>
    </div>
  </div>
</footer>
