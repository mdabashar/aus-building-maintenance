---
import { site } from '../data/site';

const points = [
  { label: `Licence No. ${site.licenceNumber}`, sub: 'Fully licensed' },
  { label: 'Fully insured', sub: 'Public liability cover' },
  { label: 'Free quotes', sub: 'On site, no obligation' },
  { label: 'Local to Kingston', sub: 'Logan & Brisbane southside' },
];
---

<section class="border-b border-ink-100 bg-white">
  <ul class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-4 py-8 lg:grid-cols-4">
    {
      points.map((p) => (
        <li class="flex items-start gap-3 px-2 py-2">
          <svg
            class="mt-0.5 h-6 w-6 flex-shrink-0 text-brand-500"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z"
              clip-rule="evenodd"
            />
          </svg>
          <span>
            <span class="block text-sm font-bold text-ink-950">{p.label}</span>
            <span class="block text-xs text-ink-500">{p.sub}</span>
          </span>
        </li>
      ))
    }
  </ul>
</section>
