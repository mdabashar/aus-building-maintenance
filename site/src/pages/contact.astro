---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
import { href } from '../lib/url';

const mapQuery = encodeURIComponent(site.address.full);
---

<BaseLayout
  title="Contact Us"
  description={`Contact ${site.name} — call ${site.phoneDisplay}, message on WhatsApp or email ${site.email}. Based in Kingston QLD, servicing Logan and the Brisbane southside.`}
>
  <section class="bg-ink-950 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400">
        <a href={href('/')} class="hover:text-brand-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-ink-200">Contact</span>
      </nav>
      <h1 class="font-display text-4xl text-white sm:text-5xl">Contact us</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-200">
        Call, message or send through the form — whatever suits. Quotes are free
        and there is no obligation.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="font-display text-2xl text-ink-950">Get in touch</h2>

        <ul class="mt-6 space-y-5">
          <li class="flex gap-4">
            <span
              class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded bg-brand-500 text-ink-950"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z"
                ></path>
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-500">Phone</p>
              <a
                href={site.phoneHref}
                class="font-display text-xl text-ink-950 hover:text-brand-600"
                >{site.phoneDisplay}</a
              >
              <p class="text-sm text-ink-500">{site.phone}</p>
            </div>
          </li>

          <li class="flex gap-4">
            <span
              class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded bg-[#25D366] text-white"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.488"
                ></path>
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-500">WhatsApp</p>
              <a
                href={site.whatsapp}
                rel="noopener"
                class="text-lg font-bold text-ink-950 hover:text-brand-600"
                >Send us a message</a
              >
              <p class="text-sm text-ink-500">
                Handy for sending photos of the job.
              </p>
            </div>
          </li>

          <li class="flex gap-4">
            <span
              class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded bg-ink-950 text-brand-500"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"
                ></path>
                <path
                  d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"
                ></path>
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-500">Email</p>
              <a
                href={`mailto:${site.email}`}
                class="text-lg font-bold break-all text-ink-950 hover:text-brand-600"
                >{site.email}</a
              >
            </div>
          </li>

          <li class="flex gap-4">
            <span
              class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded bg-ink-950 text-brand-500"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="m11.54 22.351.07.04.028.016a.76.76 0 0 0 .723 0l.028-.015.071-.041a16.975 16.975 0 0 0 1.144-.742 19.58 19.58 0 0 0 2.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 0 0-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 0 0 2.682 2.282 16.975 16.975 0 0 0 1.145.742ZM12 13.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                  clip-rule="evenodd"></path>
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-500">Address</p>
              <p class="text-lg font-bold text-ink-950">{site.address.full}</p>
              <p class="text-sm text-ink-500">
                Office address — we come to you for quotes.
              </p>
            </div>
          </li>
        </ul>

        <h2 class="font-display mt-10 text-2xl text-ink-950">Hours</h2>
        <dl class="mt-4 divide-y divide-ink-200 border-y border-ink-200">
          {
            site.hours.map((h) => (
              <div class="flex justify-between gap-4 py-3">
                <dt class="text-ink-600">{h.days}</dt>
                <dd class="font-semibold text-ink-950">{h.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-3 text-sm text-ink-500">
          Outside hours, leave a message or send an email and we will come back
          to you.
        </p>

        <dl class="mt-8 rounded-lg bg-ink-50 p-5 text-sm">
          <div class="flex justify-between gap-4 py-1">
            <dt class="text-ink-600">Licence No.</dt>
            <dd class="font-semibold text-ink-950">{site.licenceNumber}</dd>
          </div>
          <div class="flex justify-between gap-4 py-1">
            <dt class="text-ink-600">Company No.</dt>
            <dd class="font-semibold text-ink-950">{site.companyNumber}</dd>
          </div>
        </dl>
      </div>

      <div>
        <QuoteForm heading="Send us a message" />
      </div>
    </div>
  </section>

  <section class="border-t border-ink-100">
    <iframe
      title={`Map showing ${site.address.full}`}
      src={`https://www.google.com/maps?q=${mapQuery}&z=14&output=embed`}
      width="100%"
      height="420"
      style="border:0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</BaseLayout>
