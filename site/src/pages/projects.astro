---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPhoto from '../components/ProjectPhoto.astro';
import CTABand from '../components/CTABand.astro';
import { services } from '../data/services';
import { projects, servicesWithPhotos } from '../data/projects';
import { href } from '../lib/url';

/**
 * Filtered client-side rather than as separate pages — it keeps the URL stable
 * and avoids a dozen thin gallery pages competing with the service pages in
 * search.
 */
const filters = services.filter((s) => servicesWithPhotos.has(s.slug));
---

<BaseLayout
  title="Our Projects"
  description="Recent building, renovation and maintenance work across Kingston, Logan and the Brisbane southside — kitchens, bathrooms, waterproofing, tiling, flooring, fencing and retaining walls."
>
  <section class="bg-ink-950 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400">
        <a href={href('/')} class="hover:text-brand-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-ink-200">Projects</span>
      </nav>
      <h1 class="font-display text-4xl text-white sm:text-5xl">Our projects</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-200">
        Recent work from around Logan and the Brisbane southside — finished jobs
        and a few shots of what happens before the finishes go on.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <div
      class="mb-8 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter projects by service"
    >
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="filter-btn rounded-full border-2 border-ink-950 bg-ink-950 px-4 py-2 text-sm font-bold text-white transition"
      >
        All work
      </button>
      {
        filters.map((f) => (
          <button
            type="button"
            data-filter={f.slug}
            aria-pressed="false"
            class="filter-btn rounded-full border-2 border-ink-200 px-4 py-2 text-sm font-bold text-ink-700 transition hover:border-brand-500"
          >
            {f.short}
          </button>
        ))
      }
    </div>

    <div id="project-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <div class="project-item" data-services={p.services.join(' ')}>
            <ProjectPhoto project={p} />
          </div>
        ))
      }
    </div>

    <p id="empty-state" hidden class="py-12 text-center text-ink-500">
      No photos in this category yet.
    </p>

    <p class="mt-10 text-sm text-ink-500">
      Photographs are of our own completed and in-progress work. We are adding
      more as jobs finish — if you would like to see something specific, just
      ask.
    </p>
  </section>

  <CTABand
    heading="Want something like this at your place?"
    body="Free on-site quotes across Logan and the Brisbane southside."
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const empty = document.getElementById('empty-state');

  const active = ['border-ink-950', 'bg-ink-950', 'text-white'];
  const inactive = ['border-ink-200', 'text-ink-700'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('hover:border-brand-500', !on);
        active.forEach((c) => b.classList.toggle(c, on));
        inactive.forEach((c) => b.classList.toggle(c, !on));
      });

      let shown = 0;
      items.forEach((item) => {
        // A photo can belong to several services, e.g. waterproofing shows
        // under both Bathroom renovation and Tiling.
        const owned = (item.dataset.services ?? '').split(' ');
        const match = filter === 'all' || owned.includes(filter as string);
        item.hidden = !match;
        if (match) shown++;
      });

      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
