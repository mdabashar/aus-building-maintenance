---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import CTABand from '../components/CTABand.astro';
import { services } from '../data/services';
import { href } from '../lib/url';

/**
 * Gallery is filtered client-side with a tiny script rather than separate
 * pages — it keeps the URL stable and avoids a dozen thin gallery pages
 * competing with the service pages in search.
 *
 * Replace this array with real projects. Each `service` value must match a
 * service slug so the filter buttons work.
 */
const projects = [
  { service: 'decking', title: 'Hardwood deck', suburb: 'Springwood' },
  { service: 'decking', title: 'Elevated deck with stairs', suburb: 'Rochedale' },
  { service: 'bathroom-renovation', title: 'Full bathroom renovation', suburb: 'Kingston' },
  { service: 'bathroom-renovation', title: 'Ensuite renovation', suburb: 'Shailer Park' },
  { service: 'kitchen-renovation', title: 'Open-plan kitchen', suburb: 'Underwood' },
  { service: 'fencing', title: 'Colorbond boundary fence', suburb: 'Marsden' },
  { service: 'fencing', title: 'Timber paling fence and gates', suburb: 'Woodridge' },
  { service: 'retaining-walls', title: 'Concrete sleeper retaining wall', suburb: 'Browns Plains' },
  { service: 'patios', title: 'Insulated patio', suburb: 'Loganholme' },
  { service: 'landscaping', title: 'Full backyard transformation', suburb: 'Beenleigh' },
  { service: 'tiling', title: 'Large-format floor tiling', suburb: 'Slacks Creek' },
  { service: 'renovations-extensions', title: 'Rear extension and build-under', suburb: 'Sunnybank' },
];

const usedSlugs = [...new Set(projects.map((p) => p.service))];
const filters = services.filter((s) => usedSlugs.includes(s.slug));
---

<BaseLayout
  title="Our Projects"
  description="Recent building, renovation and maintenance projects across Kingston, Logan and the Brisbane southside — decks, patios, fencing, retaining walls, bathrooms, kitchens and extensions."
>
  <section class="bg-ink-950 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400">
        <a href={href('/')} class="hover:text-brand-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-ink-200">Projects</span>
      </nav>
      <h1 class="font-display text-4xl text-white sm:text-5xl">Our projects</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-200">
        A selection of recent work around Logan and the Brisbane southside.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:py-16">
    <p
      class="mb-8 rounded border-2 border-dashed border-brand-400 bg-brand-50 p-4 text-sm text-brand-900"
    >
      <strong>Placeholder gallery.</strong> Replace the `projects` array in
      <code class="font-mono">src/pages/projects.astro</code> with real jobs and
      swap each placeholder for a photo. Before/after pairs convert best.
    </p>

    <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="Filter projects">
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="filter-btn rounded-full border-2 border-ink-950 bg-ink-950 px-4 py-2 text-sm font-bold text-white transition"
      >
        All work
      </button>
      {
        filters.map((f) => (
          <button
            type="button"
            data-filter={f.slug}
            aria-pressed="false"
            class="filter-btn rounded-full border-2 border-ink-200 px-4 py-2 text-sm font-bold text-ink-700 transition hover:border-brand-500"
          >
            {f.short}
          </button>
        ))
      }
    </div>

    <div id="project-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <figure class="project-item" data-service={p.service}>
            <Placeholder label={`${p.title} — ${p.suburb}`} />
            <figcaption class="mt-3">
              <span class="font-display block text-ink-950">{p.title}</span>
              <span class="text-sm text-ink-500">{p.suburb}, QLD</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p id="empty-state" hidden class="py-12 text-center text-ink-500">
      No projects in this category yet.
    </p>
  </section>

  <CTABand
    heading="Want something like this at your place?"
    body="Free on-site quotes across Logan and the Brisbane southside."
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const empty = document.getElementById('empty-state');

  const active = ['border-ink-950', 'bg-ink-950', 'text-white'];
  const inactive = ['border-ink-200', 'text-ink-700'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('hover:border-brand-500', !on);
        active.forEach((c) => b.classList.toggle(c, on));
        inactive.forEach((c) => b.classList.toggle(c, !on));
      });

      let shown = 0;
      items.forEach((item) => {
        const match = filter === 'all' || item.dataset.service === filter;
        item.hidden = !match;
        if (match) shown++;
      });

      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
