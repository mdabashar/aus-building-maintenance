---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const updated = '29 July 2026';
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${site.name} collects, uses and protects the personal information you provide through this website.`}
>
  <section class="bg-ink-950 py-14">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="font-display text-4xl text-white">Privacy policy</h1>
      <p class="mt-3 text-ink-300">Last updated: {updated}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <p
      class="mb-8 rounded border-2 border-dashed border-brand-400 bg-brand-50 p-4 text-sm text-brand-900"
    >
      <strong>Template — review before launch.</strong> This is a general policy
      covering the data this website actually collects. It is not legal advice.
      If the business starts collecting more than enquiry details, have it
      reviewed.
    </p>

    <div class="space-y-8 text-ink-700">
      <div>
        <h2 class="font-display text-2xl text-ink-950">Who we are</h2>
        <p class="mt-3 leading-relaxed">
          This website is operated by {site.name} (Company No. {
            site.companyNumber
          }), {site.address.full}. You can contact us at
          <a
            href={`mailto:${site.email}`}
            class="text-brand-600 hover:underline">{site.email}</a
          > or on {site.phone}.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink-950">
          What we collect
        </h2>
        <p class="mt-3 leading-relaxed">
          When you submit an enquiry or quote request we collect the details you
          type into the form: your name, phone number, email address, suburb, the
          service you are interested in, and whatever you tell us about the job.
        </p>
        <p class="mt-3 leading-relaxed">
          We also collect standard analytics data about how the site is used —
          pages visited, approximate location, device and browser type, and how
          you found us. This is aggregated and is not used to identify you
          personally.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink-950">How we use it</h2>
        <p class="mt-3 leading-relaxed">
          We use your details for one purpose: to respond to your enquiry and, if
          you go ahead, to carry out the work. We do not sell your information,
          and we do not add you to a marketing list without asking.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink-950">Who else sees it</h2>
        <p class="mt-3 leading-relaxed">
          Form submissions are delivered to our business email through a
          third-party form service. Website analytics are processed by Google
          Analytics. Where a job requires it, we may share relevant details with
          subcontractors, suppliers, engineers or certifiers working on your
          project. We may also disclose information where the law requires it.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink-950">Cookies</h2>
        <p class="mt-3 leading-relaxed">
          This site uses cookies for analytics. You can block or delete cookies
          in your browser settings; the site will still work normally without
          them.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink-950">
          Access, correction and complaints
        </h2>
        <p class="mt-3 leading-relaxed">
          You can ask us what personal information we hold about you, ask us to
          correct it, or ask us to delete it. Email
          <a
            href={`mailto:${site.email}`}
            class="text-brand-600 hover:underline">{site.email}</a
          > and we will respond within a reasonable period.
        </p>
        <p class="mt-3 leading-relaxed">
          If you are not satisfied with how we have handled your information, you
          can lodge a complaint with the Office of the Australian Information
          Commissioner at
          <a
            href="https://www.oaic.gov.au"
            rel="noopener"
            class="text-brand-600 hover:underline">oaic.gov.au</a
          >.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-ink-950">Changes</h2>
        <p class="mt-3 leading-relaxed">
          We may update this policy from time to time. The date at the top of the
          page shows when it was last changed.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
