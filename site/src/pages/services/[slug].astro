---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import FAQ from '../../components/FAQ.astro';
import Placeholder from '../../components/Placeholder.astro';
import CTABand from '../../components/CTABand.astro';
import ProjectPhoto from '../../components/ProjectPhoto.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';
import { projectsForService } from '../../data/projects';
import { href, absoluteUrl } from '../../lib/url';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);

// Real photos for this trade, if the client has supplied any. Finished shots
// lead — they are what a prospective customer wants to see first.
const photos = projectsForService(service.slug).sort((a, b) =>
  a.stage === b.stage ? 0 : a.stage === 'finished' ? -1 : 1,
);
const heroPhoto = photos[0];
const galleryPhotos = photos.slice(0, 8);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.summary,
    serviceType: service.name,
    provider: { '@id': `${absoluteUrl('/', Astro.site)}#business` },
    areaServed: site.serviceAreas.map((a) => ({
      '@type': 'Place',
      name: `${a}, QLD`,
    })),
    url: absoluteUrl(`/services/${service.slug}`, Astro.site),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: absoluteUrl('/', Astro.site),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: absoluteUrl('/services', Astro.site),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.name,
        item: absoluteUrl(`/services/${service.slug}`, Astro.site),
      },
    ],
  },
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  schema={schema}
  bareTitle
>
  <section class="bg-ink-950 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400">
        <a href={href('/')} class="hover:text-brand-400">Home</a>
        <span class="mx-2">/</span>
        <a href={href('/services')} class="hover:text-brand-400">Services</a>
        <span class="mx-2">/</span>
        <span class="text-ink-200">{service.name}</span>
      </nav>

      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <h1 class="font-display text-4xl text-white sm:text-5xl">
            {service.name}
          </h1>
          <p class="mt-4 max-w-xl text-lg text-ink-200">{service.summary}</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a
              href={site.phoneHref}
              class="rounded bg-brand-500 px-7 py-3.5 text-center font-bold text-ink-950 transition hover:bg-brand-400"
            >
              Call {site.phoneDisplay}
            </a>
            <a
              href="#quote"
              class="rounded border-2 border-white/30 px-7 py-3.5 text-center font-bold text-white transition hover:border-brand-500 hover:text-brand-400"
            >
              Get a free quote
            </a>
          </div>
        </div>

        {
          heroPhoto ? (
            <ProjectPhoto
              project={heroPhoto}
              ratio="aspect-[4/3]"
              caption={false}
              eager
              sizes="(min-width: 1024px) 560px, 100vw"
              class="w-full"
            />
          ) : (
            <Placeholder
              label={`Hero photo — a finished ${service.short.toLowerCase()} job.`}
              class="w-full"
            />
          )
        }
      </div>
    </div>
  </section>

  <!-- Intro + inclusions -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        {
          service.intro.map((p) => (
            <p class="mb-4 text-lg leading-relaxed text-ink-700">{p}</p>
          ))
        }

        <h2 class="font-display mt-10 text-2xl text-ink-950">
          What's included
        </h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            service.includes.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg
                  class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-500"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="text-ink-700">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="lg:sticky lg:top-32 lg:self-start">
        <div class="rounded-lg border border-ink-200 bg-ink-50 p-6">
          <h2 class="font-display text-xl text-ink-950">Quick enquiry</h2>
          <p class="mt-2 text-sm text-ink-600">
            Fastest way to get a price is a quick call — we can often tell you
            over the phone whether it needs a site visit.
          </p>
          <a
            href={site.phoneHref}
            class="font-display mt-5 block rounded bg-brand-500 px-5 py-4 text-center text-xl text-ink-950 transition hover:bg-brand-400"
          >
            {site.phoneDisplay}
          </a>
          <a
            href={site.whatsapp}
            rel="noopener"
            class="mt-3 block rounded border-2 border-ink-300 px-5 py-3 text-center font-bold text-ink-800 transition hover:border-brand-500 hover:text-brand-700"
          >
            Message on WhatsApp
          </a>
          <dl class="mt-6 space-y-2 border-t border-ink-200 pt-5 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-ink-500">Licence</dt>
              <dd class="font-semibold text-ink-900">{site.licenceNumber}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-500">Based in</dt>
              <dd class="font-semibold text-ink-900">Kingston QLD</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-ink-500">Quotes</dt>
              <dd class="font-semibold text-ink-900">Free, no obligation</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-ink-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="font-display text-3xl text-white sm:text-4xl">
        How the job runs
      </h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          service.process.map((step, i) => (
            <li>
              <span class="font-display flex h-11 w-11 items-center justify-center rounded bg-brand-500 text-lg text-ink-950">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display mt-4 text-lg text-white">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-300">
                {step.detail}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Gallery -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <h2 class="font-display text-3xl text-ink-950 sm:text-4xl">
      {service.name} we've done
    </h2>
    <p class="mt-3 max-w-2xl text-ink-600">
      Recent work from around Logan and the Brisbane southside.
    </p>

    {
      galleryPhotos.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {galleryPhotos.map((p) => (
            <ProjectPhoto
              project={p}
              ratio="aspect-square"
              sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw"
            />
          ))}
        </div>
      ) : (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[1, 2, 3, 4].map((n) => (
            <Placeholder
              label={`${service.short} job ${n} — before/after pairs work best here.`}
              ratio="aspect-square"
            />
          ))}
        </div>
      )
    }

    {
      galleryPhotos.length > 0 && (
        <a
          href={href('/projects')}
          class="mt-8 inline-block font-bold text-brand-600 underline underline-offset-4 hover:text-brand-700"
        >
          See all our projects
        </a>
      )
    }
  </section>

  <FAQ faqs={service.faqs} heading={`${service.name} — common questions`} />

  <!-- Quote form -->
  <section id="quote" class="bg-ink-50 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <QuoteForm
        preselect={service.name}
        heading={`Get a free ${service.short.toLowerCase()} quote`}
      />
    </div>
  </section>

  <!-- Related services -->
  <section class="mx-auto max-w-7xl px-4 py-16">
    <h2 class="font-display text-2xl text-ink-950">Other services</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        related.map((r) => (
          <a
            href={href(`/services/${r.slug}`)}
            class="rounded-lg border border-ink-200 p-5 transition hover:border-brand-500 hover:shadow-md"
          >
            <h3 class="font-display text-lg text-ink-950">{r.name}</h3>
            <p class="mt-1.5 text-sm text-ink-600">{r.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>
