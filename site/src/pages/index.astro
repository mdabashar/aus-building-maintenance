---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import CTABand from '../components/CTABand.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { href } from '../lib/url';

const reasons = [
  {
    title: 'One licensed builder, every trade',
    body: 'From a fence panel to a full extension, you deal with one person who coordinates the lot — no chasing six subcontractors yourself.',
  },
  {
    title: 'Fixed written quotes',
    body: 'You get an itemised quote before anything starts, and we talk to you before any variation, not after.',
  },
  {
    title: 'Work done to standard',
    body: 'Licensed trades on plumbing and electrical, certified waterproofing, engineering where the job calls for it.',
  },
  {
    title: 'We turn up and clean up',
    body: 'We keep to the agreed schedule, keep the site tidy every day, and take all the waste with us at the end.',
  },
];
---

<BaseLayout
  title={`${site.shortName} | Builders & Maintenance in Kingston, Logan QLD`}
  description={site.description}
  bareTitle
>
  <!-- Hero -->
  <section class="relative bg-ink-950">
    <div class="absolute inset-0 opacity-25" aria-hidden="true">
      <div
        class="h-full w-full"
        style="background-image: repeating-linear-gradient(135deg, #f5921e 0 2px, transparent 2px 60px);"
      >
      </div>
    </div>

    <div
      class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24"
    >
      <div>
        <p
          class="inline-block rounded bg-brand-500/15 px-3 py-1 text-sm font-semibold tracking-wide text-brand-400"
        >
          Licence No. {site.licenceNumber} · Fully insured
        </p>
        <h1
          class="font-display mt-5 text-4xl leading-[1.05] text-white sm:text-5xl lg:text-6xl"
        >
          Licensed builders &amp;<br />
          <span class="text-brand-500">maintenance</span> across Logan
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-200">
          Carpentry, decking, patios, fencing, retaining walls, kitchens,
          bathrooms and full renovations — built properly, quoted honestly, and
          finished when we said we would.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.phoneHref}
            class="rounded bg-brand-500 px-8 py-4 text-center text-lg font-bold text-ink-950 transition hover:bg-brand-400"
          >
            Call {site.phoneDisplay}
          </a>
          <a
            href={href('/quote')}
            class="rounded border-2 border-white/30 px-8 py-4 text-center text-lg font-bold text-white transition hover:border-brand-500 hover:text-brand-400"
          >
            Get a Free Quote
          </a>
        </div>

        <p class="mt-5 text-sm text-ink-300">
          Prefer to message? <a
            href={site.whatsapp}
            rel="noopener"
            class="font-semibold text-brand-400 underline underline-offset-2"
            >Send us a WhatsApp</a
          >.
        </p>
      </div>

      <Placeholder
        label="Hero shot — the team on site, or a finished deck / renovation. Landscape, high resolution."
        ratio="aspect-[4/3]"
        class="w-full"
      />
    </div>
  </section>

  <TrustBar />

  <!-- Services -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="font-semibold tracking-widest text-brand-600 uppercase">
        What we do
      </p>
      <h2 class="font-display mt-2 text-3xl text-ink-950 sm:text-4xl">
        Our services
      </h2>
      <p class="mt-3 text-lg text-ink-600">
        Twelve trades under one licence. If it involves building, renovating or
        maintaining your property, it is worth asking us.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <!-- Why choose us -->
  <section class="bg-ink-950 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="mb-10 max-w-2xl">
        <p class="font-semibold tracking-widest text-brand-500 uppercase">
          Why us
        </p>
        <h2 class="font-display mt-2 text-3xl text-white sm:text-4xl">
          Built on doing it properly
        </h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2">
        {
          reasons.map((r, i) => (
            <div class="flex gap-4">
              <span class="font-display flex h-11 w-11 flex-shrink-0 items-center justify-center rounded bg-brand-500 text-lg text-ink-950">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-display text-lg text-white">{r.title}</h3>
                <p class="mt-1.5 leading-relaxed text-ink-300">{r.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent work -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="font-semibold tracking-widest text-brand-600 uppercase">
          Our work
        </p>
        <h2 class="font-display mt-2 text-3xl text-ink-950 sm:text-4xl">
          Recent projects
        </h2>
      </div>
      <a
        href={href('/projects')}
        class="font-bold text-brand-600 underline underline-offset-4 hover:text-brand-700"
        >See more projects</a
      >
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          'Deck build — Springwood',
          'Bathroom renovation — Kingston',
          'Colorbond fencing — Marsden',
          'Kitchen renovation — Underwood',
          'Retaining wall — Browns Plains',
          'Patio build — Loganholme',
        ].map((label) => <Placeholder label={label} />)
      }
    </div>
  </section>

  <Testimonials />

  <!-- Service area -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="font-semibold tracking-widest text-brand-600 uppercase">
          Where we work
        </p>
        <h2 class="font-display mt-2 text-3xl text-ink-950 sm:text-4xl">
          Servicing Logan &amp; the Brisbane southside
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-ink-600">
          We are based in Kingston and work throughout Logan and the southern
          Brisbane suburbs. Not sure if you are in range? Give us a call — if we
          cannot help we will usually know someone who can.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            site.serviceAreas.map((area) => (
              <li class="rounded-full bg-ink-100 px-3.5 py-1.5 text-sm font-medium text-ink-700">
                {area}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="overflow-hidden rounded-lg border border-ink-200">
        <iframe
          title="Map showing our service area around Kingston, Logan QLD"
          src="https://www.google.com/maps?q=Kingston%20QLD%204114%20Australia&z=12&output=embed"
          width="100%"
          height="420"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
