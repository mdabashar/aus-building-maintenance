---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../data/site';
import { href } from '../lib/url';

const steps = [
  {
    title: 'Send through the details',
    body: 'The form takes about a minute. The more you tell us about size and timing, the more accurate our first answer will be.',
  },
  {
    title: 'We call you back',
    body: 'Usually within one business day. For simple jobs we can often give you a price range on the phone.',
  },
  {
    title: 'Free on-site visit',
    body: 'For anything substantial we come out, measure up and check the things that move the price.',
  },
  {
    title: 'Written fixed quote',
    body: 'Itemised, in writing, with a timeframe. No obligation to proceed.',
  },
];
---

<BaseLayout
  title="Get a Free Quote"
  description={`Request a free, no-obligation quote from ${site.name}. Servicing Kingston, Logan and the Brisbane southside. Call ${site.phoneDisplay}.`}
>
  <section class="bg-ink-950 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400">
        <a href={href('/')} class="hover:text-brand-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-ink-200">Get a quote</span>
      </nav>
      <h1 class="font-display text-4xl text-white sm:text-5xl">
        Get a free quote
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-200">
        No charge, no obligation. Tell us what you need and we will come back to
        you with a straight answer.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={site.phoneHref}
          class="rounded bg-brand-500 px-7 py-3.5 text-center font-bold text-ink-950 transition hover:bg-brand-400"
        >
          Rather call? {site.phoneDisplay}
        </a>
        <a
          href={site.whatsapp}
          rel="noopener"
          class="rounded border-2 border-white/30 px-7 py-3.5 text-center font-bold text-white transition hover:border-brand-500 hover:text-brand-400"
        >
          Message on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
      <QuoteForm heading="Tell us about your job" />

      <div>
        <h2 class="font-display text-2xl text-ink-950">What happens next</h2>
        <ol class="mt-6 space-y-6">
          {
            steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="font-display flex h-10 w-10 flex-shrink-0 items-center justify-center rounded bg-brand-500 text-ink-950">
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-bold text-ink-950">{s.title}</h3>
                  <p class="mt-1 text-ink-600">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 rounded-lg bg-ink-50 p-6">
          <h3 class="font-display text-lg text-ink-950">
            Photos speed things up
          </h3>
          <p class="mt-2 text-ink-600">
            If you can, send a few photos of the area through
            <a
              href={site.whatsapp}
              rel="noopener"
              class="font-semibold text-brand-600 hover:underline">WhatsApp</a
            >
            or by
            <a
              href={`mailto:${site.email}`}
              class="font-semibold text-brand-600 hover:underline">email</a
            >. It often saves a site visit entirely.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
