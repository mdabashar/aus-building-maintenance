---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { href } from '../lib/url';

// Form submissions redirect here. Useful as a conversion goal in GA4 —
// count pageviews of /thank-you as a completed enquiry.
---

<BaseLayout
  title="Thanks — we've got your enquiry"
  description="Your enquiry has been received. We will be in touch shortly."
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:py-32">
    <span
      class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-500 text-ink-950"
    >
      <svg
        class="h-8 w-8"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"
        ></path>
      </svg>
    </span>

    <h1 class="font-display mt-6 text-4xl text-ink-950">Thanks — got it</h1>
    <p class="mt-4 text-lg text-ink-600">
      Your enquiry has come through and we will get back to you, usually within
      one business day.
    </p>
    <p class="mt-3 text-ink-600">
      In a hurry? Call <a
        href={site.phoneHref}
        class="font-bold text-brand-600 hover:underline">{site.phoneDisplay}</a
      > or
      <a
        href={site.whatsapp}
        rel="noopener"
        class="font-bold text-brand-600 hover:underline">message us on WhatsApp</a
      >.
    </p>

    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={href('/')}
        class="rounded bg-ink-950 px-7 py-3.5 font-bold text-white transition hover:bg-ink-800"
        >Back to home</a
      >
      <a
        href={href('/projects')}
        class="rounded border-2 border-ink-300 px-7 py-3.5 font-bold text-ink-800 transition hover:border-brand-500 hover:text-brand-700"
        >See our work</a
      >
    </div>
  </section>
</BaseLayout>
