---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import CTABand from '../components/CTABand.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { href } from '../lib/url';
---

<BaseLayout
  title="About Us"
  description={`${site.name} — licensed builders based in Kingston QLD, servicing Logan and the Brisbane southside. Licence No. ${site.licenceNumber}.`}
>
  <section class="bg-ink-950 py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-ink-400">
        <a href={href('/')} class="hover:text-brand-400">Home</a>
        <span class="mx-2">/</span>
        <span class="text-ink-200">About</span>
      </nav>
      <h1 class="font-display text-4xl text-white sm:text-5xl">
        About {site.shortName}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-200">
        A licensed building and maintenance company based in Kingston, working
        across Logan and the southern Brisbane suburbs.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div>
        <p
          class="mb-6 rounded border-2 border-dashed border-brand-400 bg-brand-50 p-4 text-sm text-brand-900"
        >
          <strong>Draft copy.</strong> Replace this section with the owner's own
          story — when the business started, background and trade history, and
          what they want to be known for. Written in the client's own words it
          will read far better than anything generic.
        </p>

        <h2 class="font-display text-3xl text-ink-950">Who we are</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-700">
          {site.name} is a licensed building and maintenance company operating
          out of Kingston in Logan. We take on everything from small maintenance
          jobs through to full renovations and extensions, which means most
          customers can call the same number whether they need a fence panel
          replaced or a second storey planned.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink-700">
          Being licensed matters more than people realise. It means the work is
          insured, that structural jobs go through proper engineering and
          certification, and that you have recourse if something is not right.
          Our licence number is {site.licenceNumber} and we are happy for you to
          check it.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink-700">
          Most of our work comes from repeat customers and referrals from
          neighbours who watched the job next door go well. That only happens if
          you turn up when you said, quote honestly, and finish properly — so
          that is what we do.
        </p>

        <h2 class="font-display mt-12 text-3xl text-ink-950">
          Licence &amp; credentials
        </h2>
        <dl class="mt-5 divide-y divide-ink-200 border-y border-ink-200">
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink-600">Licence number</dt>
            <dd class="font-semibold text-ink-950">{site.licenceNumber}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink-600">Company number</dt>
            <dd class="font-semibold text-ink-950">{site.companyNumber}</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink-600">Licence class</dt>
            <dd class="font-semibold text-ink-950">
              {
                site.licenceClass.startsWith('TODO')
                  ? 'TODO — confirm with client'
                  : site.licenceClass
              }
            </dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink-600">Public liability</dt>
            <dd class="font-semibold text-ink-950">
              {
                site.publicLiability.startsWith('TODO')
                  ? 'TODO — confirm with client'
                  : site.publicLiability
              }
            </dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-ink-600">Based in</dt>
            <dd class="font-semibold text-ink-950">Kingston QLD 4114</dd>
          </div>
        </dl>
      </div>

      <div class="space-y-4">
        <Placeholder
          label="The owner on site, or the team with the ute. A real face builds more trust than any amount of copy."
          ratio="aspect-[4/5]"
        />
        <div class="grid grid-cols-2 gap-4">
          <Placeholder label="Work in progress" ratio="aspect-square" />
          <Placeholder label="Finished job" ratio="aspect-square" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="font-display text-3xl text-ink-950 sm:text-4xl">
        What we take on
      </h2>
      <p class="mt-3 max-w-2xl text-ink-600">
        Twelve services under one licence. Click through for detail on any of
        them.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <li>
              <a
                href={href(`/services/${s.slug}`)}
                class="flex items-center gap-3 rounded border border-ink-200 bg-white px-4 py-3 font-semibold text-ink-800 transition hover:border-brand-500 hover:text-brand-700"
              >
                <svg
                  class="h-5 w-5 flex-shrink-0 text-brand-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <h2 class="font-display text-3xl text-ink-950 sm:text-4xl">
      Where we work
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-ink-600">
      We are based in Kingston and travel throughout Logan and the southern
      Brisbane suburbs. If you are just outside this list, call and ask — we can
      often still help.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        site.serviceAreas.map((area) => (
          <li class="rounded-full bg-ink-100 px-3.5 py-1.5 text-sm font-medium text-ink-700">
            {area}
          </li>
        ))
      }
    </ul>
  </section>

  <Testimonials />

  <CTABand />
</BaseLayout>
